# Sama backend (Elysia on Bun). Copy to .env; Bun loads it automatically. Never commit .env.

# Chain. 56 = BSC mainnet; SAMA_ENABLE_MAINNET=1 is required to run against it.
SAMA_CHAIN_ID=56
SAMA_ENABLE_MAINNET=1
PORT=3300

# Executor RPC and an independent verifier RPC on a different provider (archive state helps verification).
BSC_RPC_URL=https://bsc-dataseed.binance.org
VERIFIER_RPC_URL=https://bsc-rpc.publicnode.com

# SamaSettlement. Empty uses sama-packages/shared/src/deployments/<chain>.json (0x7811a30D29d6c2Ca95Aeb4EE9D896cE44Cb72AC8 on 56).
SAMA_SETTLEMENT_ADDRESS=

# Database: a postgres:// URL (Supabase, Neon) or empty for embedded PGlite in .sama-db.
DATABASE_URL=
SAMA_PGLITE_DIR=.sama-db

# Session cookie signing key (required in production; generated locally otherwise).
SESSION_SECRET=

# Privy (dashboard.privy.io -> app -> Settings): app id and app secret, used to verify access tokens and linked wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Binance Web3 RWA API (prices and bStock status). Server only.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Browser origins allowed to call the API, comma-separated, and the app origin used in invite links.
SAMA_ALLOWED_ORIGINS=http://localhost:3200
SAMA_APP_ORIGIN=http://localhost:3200
# Set to 1 when the frontend and API are on different sites (cookie becomes SameSite=None; Secure; Partitioned).
SAMA_CROSS_SITE_COOKIE=

# Safety limits while the settlement contract is unaudited.
SAMA_MAX_PLAN_USD=500
SAMA_SWAP_SLIPPAGE_BPS=50

# Local development only: POST /api/session/dev signs in with a wallet signature, without Privy.
SAMA_DEV_AUTH=

# Optional natural-language target agent.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Seconds between background round advances (freeze, expire, resume settlement).
SAMA_CRON_INTERVAL_SEC=60
